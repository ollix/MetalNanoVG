# Compile the Metal shader into the platform headers under src/mnvg_bitcode.

set -e
cd "$(dirname "${BASH_SOURCE[0]}")/../src"

output_dir=mnvg_bitcode
stage_dir=$(mktemp -d ./.metallib.XXXXXX)
trap 'rm -rf "$stage_dir"' EXIT
mkdir "$stage_dir/$output_dir"

compile_shader() {
  local sdk=$1
  local binary="$output_dir/$2"
  local air="$stage_dir/$2.air"
  shift 2

  echo "* Compiling for $sdk..."
  xcrun -sdk "$sdk" metal -c nanovg_mtl_shaders.metal "$@" -o "$air"
  xcrun -sdk "$sdk" metallib "$air" -o "$stage_dir/$binary"
  # xxd derives the C identifier from the relative path.
  (cd "$stage_dir" && xxd -i "$binary") > "$stage_dir/$binary.h"
}

compile_shader iphoneos ios -mios-version-min=8.0
compile_shader iphonesimulator simulator -target air64-apple-ios13.2-simulator
compile_shader macosx macos -mmacosx-version-min=10.11
compile_shader appletvos tvos -target air64-apple-tvos13.2
compile_shader xros xros -target air64-apple-xros1.0

# Replace the bundled headers only after all five libraries have been built.
mkdir -p "$output_dir"
mv "$stage_dir/$output_dir/"*.h "$output_dir/"
echo "Done"
